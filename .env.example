# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/esell_namibia"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Local seed accounts (set before running db:seed; never commit actual values) ---
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_CUSTOMER_EMAIL=""
SEED_CUSTOMER_PASSWORD=""

# --- Image / object storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- Transactional email (Resend) ---
# Used to email every opted-in customer when a new product goes live, and for
# password reset links. Sign up free at https://resend.com, verify a sending
# domain (or leave EMAIL_FROM as the Resend sandbox address for testing), then
# create an API key. Leaving RESEND_API_KEY blank disables sending — actions
# that would send email just log to the console instead.
RESEND_API_KEY=""
EMAIL_FROM="ESell Namibia <onboarding@resend.dev>"

# --- E-Sell Namibia public contact details (used for "Contact E-Sell" / WhatsApp buttons) ---
# These are only fallback defaults used the first time /admin/settings creates its record;
# the live values are managed from /admin/settings after that.
NEXT_PUBLIC_ESELL_WHATSAPP_NUMBER="+264 81 825 8238"
NEXT_PUBLIC_ESELL_PHONE_NUMBER="081 223 9459"
NEXT_PUBLIC_ESELL_EMAIL=""

# --- Site URL (used for metadata, sitemap, absolute links) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
