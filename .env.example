# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/esell_namibia"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Local seed accounts (set before running db:seed; never commit actual values) ---
# Administrator login — the only admin account. It lives only here (never in the
# database) and cannot be reset from the website: change it and restart the server.
# Use a long password (at least 12 characters).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
SEED_CUSTOMER_EMAIL=""
SEED_CUSTOMER_PASSWORD=""

# --- Image / object storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- Email over SMTP (nodemailer) ---
# Used for sign-up verification codes (OTP), new-product alerts to every
# customer, password reset links and order confirmations.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your Gmail address and
# SMTP_PASS=a 16-character App Password (Google Account > Security > 2-Step
# Verification > App passwords). Any other SMTP provider works the same way.
# Leaving SMTP_HOST/SMTP_USER/SMTP_PASS blank disables sending: emails (including
# the sign-up code) are printed to the server console instead — dev only.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="ESell Namibia <your-address@gmail.com>"

# --- E-Sell Namibia public contact details (used for "Contact E-Sell" / WhatsApp buttons) ---
# These are only fallback defaults used the first time /admin/settings creates its record;
# the live values are managed from /admin/settings after that.
NEXT_PUBLIC_ESELL_WHATSAPP_NUMBER="+264 81 825 8238"
NEXT_PUBLIC_ESELL_PHONE_NUMBER="081 223 9459"
NEXT_PUBLIC_ESELL_EMAIL=""

# --- Site URL (used for metadata, sitemap, absolute links) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- DPO / PayToday card payments ---
# Leaving DPO_COMPANY_TOKEN blank disables "Pay by Card" at checkout — Cash/EFT
# needs zero config. Get these from your DPO Group merchant dashboard. Confirm
# with DPO directly how they want test-mode transactions handled (a separate
# test CompanyToken vs. a different endpoint) before going live.
DPO_COMPANY_TOKEN=""
DPO_SERVICE_TYPE=""
DPO_API_URL="https://secure.3gdirectpay.com/API/v6/"
DPO_CURRENCY="NAD"
