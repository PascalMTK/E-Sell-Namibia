generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum ProductCondition {
  NEW
  LIKE_NEW
  EXCELLENT
  GOOD
  USED
  REFURBISHED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  SOLD
}

enum SellRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  CONTACTED
  ACCEPTED
  REJECTED
  CONVERTED
}

enum PreferredContactMethod {
  WHATSAPP
  PHONE
  EMAIL
}

enum AdminActivityType {
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_PUBLISHED
  PRODUCT_UNPUBLISHED
  PRODUCT_SOLD
  PRODUCT_DELETED
  SELL_REQUEST_STATUS_CHANGED
  SELL_REQUEST_CONVERTED
  CATEGORY_CHANGED
  BANNER_CHANGED
  TEAM_MEMBER_CHANGED
  SETTINGS_UPDATED
}

// ---------------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sellRequests    SellRequest[]
  favorites       Favorite[]
  createdProducts Product[]        @relation("ProductCreatedBy")
  contactMessages ContactMessage[]
  adminActivity   AdminActivity[]
  passwordResets  PasswordResetToken[]

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  image       String?
  description String?
  active      Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products     Product[]
  sellRequests SellRequest[]

  @@index([slug])
}

model Product {
  id                String      @id @default(cuid())
  name              String
  slug              String      @unique
  sku               String?     @unique
  shortDescription  String?
  description       String
  price             Decimal     @db.Decimal(12, 2)
  originalPrice     Decimal?    @db.Decimal(12, 2)
  negotiable        Boolean     @default(false)
  condition         ProductCondition
  brand             String?
  model             String?
  location          String
  pickupAvailable   Boolean     @default(true)
  windhoekDelivery  Boolean     @default(false)
  nationwideDelivery Boolean    @default(false)
  quantity          Int         @default(1)
  stockStatus       StockStatus @default(IN_STOCK)
  published         Boolean     @default(false)
  featured          Boolean     @default(false)
  newArrival        Boolean     @default(false)
  onSale            Boolean     @default(false)
  sold              Boolean     @default(false)
  viewCount         Int         @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdById String?
  createdBy   User?   @relation("ProductCreatedBy", fields: [createdById], references: [id])

  sourceSellRequestId String?      @unique
  sourceSellRequest   SellRequest? @relation("SellRequestConvertedProduct", fields: [sourceSellRequestId], references: [id])

  images    ProductImage[]
  favorites Favorite[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([categoryId])
  @@index([published, featured])
  @@index([published, newArrival])
  @@index([slug])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int     @default(0)
  isCover   Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Sell Requests (customer -> admin, private)
// ---------------------------------------------------------------------------

model SellRequest {
  id     String  @id @default(cuid())
  status SellRequestStatus @default(SUBMITTED)

  customerId String?
  customer   User?   @relation(fields: [customerId], references: [id])

  customerName            String
  phone                   String
  whatsapp                String?
  email                   String?
  preferredContactMethod  PreferredContactMethod @default(WHATSAPP)

  productName String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  brand       String?
  model       String?
  condition   ProductCondition
  description String

  expectedPrice Decimal? @db.Decimal(12, 2)
  negotiable    Boolean  @default(true)
  location      String

  adminNotes String?

  convertedProduct Product? @relation("SellRequestConvertedProduct")

  statusHistory StatusHistoryEntry[] @relation("SellRequestStatusHistory")
  photos        SellRequestImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
}

model SellRequestImage {
  id            String      @id @default(cuid())
  sellRequestId String
  sellRequest   SellRequest @relation(fields: [sellRequestId], references: [id], onDelete: Cascade)
  url           String
  position      Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([sellRequestId])
}

model StatusHistoryEntry {
  id            String      @id @default(cuid())
  sellRequestId String
  sellRequest   SellRequest @relation("SellRequestStatusHistory", fields: [sellRequestId], references: [id], onDelete: Cascade)
  status        SellRequestStatus
  note          String?
  createdAt     DateTime    @default(now())

  @@index([sellRequestId])
}

// ---------------------------------------------------------------------------
// Favorites
// ---------------------------------------------------------------------------

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Marketing / content
// ---------------------------------------------------------------------------

model Banner {
  id          String    @id @default(cuid())
  heading     String
  subtitle    String?
  image       String
  ctaLabel    String?
  destination String?
  active      Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  position  String
  bio       String?
  photo     String?
  linkedin  String?
  twitter   String?
  email     String?
  active    Boolean  @default(true)
  position_ Int      @default(0) @map("sort_position")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AdminActivity {
  id          String            @id @default(cuid())
  type        AdminActivityType
  description String
  adminId     String?
  admin       User?             @relation(fields: [adminId], references: [id])
  targetId    String?
  createdAt   DateTime          @default(now())

  @@index([createdAt])
}

model SiteSetting {
  id                 String   @id @default("singleton")
  whatsappNumber     String?
  phoneNumber        String?
  email              String?
  address            String?
  businessHours      String?
  facebookUrl        String   @default("https://www.facebook.com/Esellnamibia/")
  instagramUrl       String   @default("https://www.instagram.com/esellnamibia/?hl=en")
  tiktokUrl          String   @default("https://www.tiktok.com/@e.sell.namibia")
  linkedinUrl        String   @default("https://na.linkedin.com/company/esell-namibia")
  threadsUrl         String   @default("https://www.threads.com/@esellnamibia")
  updatedAt          DateTime @updatedAt
}
